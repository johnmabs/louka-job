<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                   https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Company\Domain\Model\CompanyMember" table="company_member">

        <id name="id" type="company_member_id" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="userId" type="company_user_id" column="user_id"/>
        <field name="role" type="string" column="role" length="20" enum-type="App\Company\Domain\Model\CompanyRole"/>
        <field name="joinedAt" type="datetime_immutable" column="joined_at"/>

        <many-to-one field="company" target-entity="App\Company\Domain\Model\Company" inversed-by="members">
            <join-column name="company_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>

        <unique-constraints>
            <unique-constraint name="uniq_company_member_user" columns="company_id,user_id"/>
        </unique-constraints>

    </entity>
</doctrine-mapping>
